# Telegram Bot Configuration

# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=

# Адрес сервера GrowVision Client API
SERVER_URL=http://127.0.0.1:8000

# Секретный ключ авторизации клиентов (совпадает с CLIENT_API_KEY в server/.env)
CLIENT_API_KEY=

# Публичный адрес веб-плеера для пользователей (опционально, например http://192.168.1.10:8000)
# Если не задан, кнопка и ссылка на веб-плеер не показываются
WEB_PUBLIC_URL=
