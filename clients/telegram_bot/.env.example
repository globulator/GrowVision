# Telegram Bot Configuration

# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=

# Адрес сервера GrowVision Client API
SERVER_URL=http://127.0.0.1:8000

# Секретный ключ авторизации клиентов (совпадает с CLIENT_API_KEY в server/.env)
CLIENT_API_KEY=

# Публичный адрес веб-плеера для пользователей (опционально, например http://192.168.1.10:8000)
# Если не задан, кнопка и ссылка на веб-плеер не показываются
WEB_PUBLIC_URL=

# Прокси для подключения к Telegram API (опционально)
# Поддерживаются протоколы http:// и socks5:// (например, socks5://127.0.0.1:1080)
# Если не задан или пуст, используется прямое подключение
TELEGRAM_PROXY=

# Расширенное структурированное JSONL-журналирование событий бота (true/false)
# Сохраняется в clients/telegram_bot/logs/ с ротацией 7 дней
BOT_DEBUG_LOG=false

