# Edge Agent Environment Configuration

# URL сервера GrowVision
SERVER_URL=http://127.0.0.1:8000

# Секретный ключ для авторизации Edge-агента (заголовок X-Edge-Key, задаётся пользователем)
EDGE_API_KEY=

# Режим работы оборудования: 'rpi' (реальное железо) или 'mock' (эмуляция для тестов/ПК)
HARDWARE_MODE=mock

# Путь к ONNX-модели сегментации растений
MODEL_PATH=./models/lettuce_seg_v1.onnx

# Интервалы опроса (в секундах)
HEARTBEAT_INTERVAL_SEC=30
COMMAND_POLL_INTERVAL_SEC=2

# Параметры реле и камеры
RELAY_SWITCH_DELAY_MS=200
CAMERA_WARMUP_FRAMES=5
RELAY_ACTIVE_HIGH=true

# Каталог офлайн-очереди для неотправленных кадров
OFFLINE_QUEUE_DIR=edge_agent/offline_queue

# Дефолтный интервал плановой съемки в часах (переопределяется ответом сервера на heartbeat)
CAPTURE_INTERVAL_HOURS=1

# Режим расширенного логирования
DEBUG_MODE=false
